{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/APPX.html"
    },
    {
      "source": "/icons/:path*",
      "destination": "/icons/:path*"
    },
    {
      "source": "/api/1.2/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/api/1.2",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/admin",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/app",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/api/portals",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/api/device",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/api/session",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/proxy",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/_next/:path*",
      "destination": "/api/proxy.js?url=https://player.appx.co.in/_next/:path*"
    },
    {
      "source": "/videojs-:path*",
      "destination": "/api/proxy.js?url=https://player.appx.co.in/videojs-:path*"
    },
    {
      "source": "/video-uhs:path*",
      "destination": "/api/proxy.js?url=https://player.appx.co.in/video-uhs:path*"
    },
    {
      "source": "/uhs-hls-player/:path*",
      "destination": "/api/proxy.js?url=https://appx-play.classx.co.in/uhs-hls-player/:path*"
    }
  ]
}